<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_liquid_glass_light"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/agenda_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BttrCal · Agenda"
            android:textColor="#101828"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_btn_sync"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_pill_btn"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Sync"
            android:textColor="#0A84FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agenda_btn_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_today_circle"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/agenda_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp" />

    <TextView
        android:id="@+id/agenda_empty_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Keine anstehenden Termine in den nächsten 30 Tagen"
        android:textColor="#667085"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
