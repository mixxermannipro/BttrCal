<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_new_event"
        android:enabled="true"
        android:icon="@android:drawable/ic_input_add"
        android:shortcutShortLabel="@string/shortcut_new_event_short"
        android:shortcutLongLabel="@string/shortcut_new_event_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.bttrcal.app"
            android:targetClass="com.bttrcal.app.MainActivity">
            <extra android:name="extra_shortcut_action" android:value="new_event" />
        </intent>
    </shortcut>

